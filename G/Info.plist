<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>G</string>
    <key>CFBundleDisplayName</key>
    <string>G</string>
    <key>CFBundleIdentifier</key>
    <string>com.gehrig.g</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>

    <!-- Privacy permission descriptions -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>G needs speech recognition to understand your voice commands.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>G needs microphone access to listen to your voice.</string>
    <key>NSContactsUsageDescription</key>
    <string>G needs access to your contacts to help you find and message people.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>G needs access to your calendar to tell you about upcoming events and create new ones.</string>
    <key>NSRemindersUsageDescription</key>
    <string>G needs access to your reminders to help manage your tasks.</string>

    <!-- Siri integration -->
    <key>INIntentsSupported</key>
    <array>
        <string>AskGIntent</string>
    </array>

    <!-- URL Scheme for Live Activity deep link (push-to-talk from Lock Screen) -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>g-assistant</string>
            </array>
            <key>CFBundleURLName</key>
            <string>com.gehrig.g</string>
        </dict>
    </array>

    <!-- Support Live Activities -->
    <key>NSSupportsLiveActivities</key>
    <true/>
</dict>
</plist>
